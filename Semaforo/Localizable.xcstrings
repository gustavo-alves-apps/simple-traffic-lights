    "Both iPhones must be nearby with Wi-Fi or Bluetooth on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يكون جهازا iPhone قريبين مع تشغيل Wi-Fi أو Bluetooth."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tots dos iPhone han de ser a prop, amb el Wi-Fi o el Bluetooth activat."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oba iPhony musí být nablízku a mít zapnutou Wi-Fi nebo Bluetooth."
