    "On the other iPhone, turn on “Allow remote control”, then enter its code here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على جهاز iPhone الآخر، فعّل \"السماح بالتحكم عن بُعد\"، ثم أدخل رمزه هنا."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A l’altre iPhone, activa «Permet el control remot» i introdueix-ne el codi aquí."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na druhém iPhonu zapněte „Povolit dálkové ovládání“ a pak sem zadejte jeho kód."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå “Tillad fjernbetjening” til på den anden iPhone, og indtast derefter dens kode her."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere auf dem anderen iPhone „Fernsteuerung erlauben“ und gib dann hier seinen Code ein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Στο άλλο iPhone, ενεργοποιήστε το «Να επιτρέπεται ο απομακρυσμένος έλεγχος» και, στη συνέχεια, εισαγάγετε τον κωδικό του εδώ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el otro iPhone, activa “Permitir control remoto” e introduce su código aquí."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laita toisessa iPhonessa päälle ”Salli etäohjaus” ja syötä sen koodi tähän."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur l’autre iPhone, activez « Autoriser le contrôle à distance », puis saisissez son code ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ב-iPhone השני, הפעילו את ”אפשר שליטה מרחוק“ והזינו כאן את הקוד שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दूसरे iPhone पर “रिमोट कंट्रोल की अनुमति दें” चालू करें, फिर उसका कोड यहाँ डालें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na drugom iPhoneu uključite „Dopusti daljinsko upravljanje”, a zatim ovdje unesite njegov kôd."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A másik iPhone-on kapcsold be a „Távvezérlés engedélyezése” lehetőséget, majd írd be ide a kódját."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di iPhone lainnya, nyalakan “Izinkan kontrol jarak jauh”, lalu masukkan kodenya di sini."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sull’altro iPhone, attiva “Consenti controllo remoto”, poi inserisci qui il suo codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一方のiPhoneで「リモート操作を許可」をオンにして、表示されたコードをここに入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 iPhone에서 ‘원격 제어 허용’을 켠 다음 그 코드를 여기에 입력하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pada iPhone yang satu lagi, hidupkan “Benarkan kawalan jauh”, kemudian masukkan kodnya di sini."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på «Tillat fjernstyring» på den andre iPhonen, og skriv deretter inn koden her."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet op de andere iPhone ‘Bediening op afstand toestaan’ aan en voer hier de code in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na drugim iPhonie włącz „Zezwalaj na zdalne sterowanie”, a następnie wpisz tutaj jego kod."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No outro iPhone, ative “Permitir controle remoto” e digite o código dele aqui."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No outro iPhone, ative “Permitir controlo remoto” e introduza aqui o código dele."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pe celălalt iPhone, activează „Permite controlul de la distanță”, apoi introdu aici codul acestuia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На другом iPhone включите «Разрешить удалённое управление», затем введите здесь его код."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na druhom iPhone zapnite „Povoliť diaľkové ovládanie“ a potom sem zadajte jeho kód."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på ”Tillåt fjärrstyrning” på den andra iPhonen och ange sedan dess kod här."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บน iPhone อีกเครื่อง ให้เปิด “อนุญาตการควบคุมระยะไกล” แล้วป้อนรหัสของเครื่องนั้นที่นี่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer iPhone’da “Uzaktan kontrole izin ver” seçeneğini açın, ardından onun kodunu buraya girin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На іншому iPhone увімкніть «Дозволити дистанційне керування», а потім введіть тут його код."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trên iPhone kia, bật “Cho phép điều khiển từ xa”, sau đó nhập mã của máy đó vào đây."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在另一台 iPhone 上打开“允许远程控制”，然后在此输入它的配对码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在另一支 iPhone 上開啟「允許遠端控制」，然後在此輸入它的配對碼。"
          }
        }
      }
    },
