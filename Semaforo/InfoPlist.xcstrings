    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم للإقران مع جهاز iPhone قريب ليتمكن من تغيير إشارة المرور عن بُعد."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’utilitza per emparellar-se amb un iPhone proper perquè pugui canviar el semàfor a distància."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slouží ke spárování s iPhonem v okolí, aby mohl semafor ovládat na dálku."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruges til at parre med en iPhone i nærheden, så den kan skifte trafiklyset på afstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um ein iPhone in der Nähe zu koppeln, damit es die Ampel aus der Ferne umschalten kann."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιείται για σύζευξη με ένα κοντινό iPhone, ώστε να μπορεί να αλλάζει το φανάρι από απόσταση."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to pair with a nearby iPhone so it can change the traffic light remotely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para vincularse con un iPhone cercano y que pueda cambiar el semáforo a distancia."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytetään lähellä olevan iPhonen yhdistämiseen, jotta se voi vaihtaa liikennevaloa etänä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé pour s’associer à un iPhone à proximité afin qu’il puisse changer le feu à distance."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "משמש לצימוד עם iPhone קרוב כדי שיוכל להחליף את הרמזור מרחוק."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पास के iPhone से पेयर करने के लिए उपयोग किया जाता है ताकि वह ट्रैफ़िक लाइट को दूर से बदल सके।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koristi se za uparivanje s obližnjim iPhoneom kako bi mogao daljinski mijenjati semafor."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy közeli iPhone-nal való párosításhoz használatos, hogy az távolról válthassa a lámpát."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan untuk memasangkan dengan iPhone di dekat Anda agar dapat mengganti lampu lalu lintas dari jarak jauh."
